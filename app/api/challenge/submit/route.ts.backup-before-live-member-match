function parseStars(
  text: string
): number | null {
  /*
   * De sterrenzone wordt apart OCR'en.
   *
   * Belangrijk voorbeeld uit onze echte test:
   *
   *   1
   *   *
   *   22
   *
   * Dit kan visueel betekenen:
   *   ★  -> OCR "1"
   *   ★  -> OCR "*"
   *   ☆  -> OCR "22"
   *
   * Dus: 2 gevulde sterren + 1 lege ster = 2 sterren.
   *
   * We behandelen de OCR daarom als een patroon van
   * visuele sterobjecten en niet als een gewoon getal.
   */

  const normalized =
    text
      .replace(/\r/g, "")
      .trim();

  if (!normalized) {
    return null;
  }

  /*
   * 1. Echte stertekens.
   */
  const filledSymbolCount =
    (
      normalized.match(
        /[★⭐*]/g
      ) ?? []
    ).length;

  /*
   * 2. Losse "1" in de speciale sterzone.
   *
   * Tesseract leest een gevulde ster in onze test als "1".
   * Alleen een LOSSE 1 telt mee.
   */
  const standaloneOneCount =
    (
      normalized.match(
        /(?:^|\s)1(?:\s|$)/g
      ) ?? []
    ).length;

  /*
   * 3. Losse 0/2/3 mogen niet zomaar als steraantal
   * worden geïnterpreteerd.
   *
   * Met name "22" laten we bewust buiten beschouwing:
   * dat is waarschijnlijk OCR van een leeg stericoon.
   */

  const filledStars =
    filledSymbolCount +
    standaloneOneCount;

  if (
    filledStars >= 1 &&
    filledStars <= 3
  ) {
    return filledStars;
  }

  /*
   * Klassieke fallback wanneer Tesseract wél netjes
   * één numerieke sterwaarde teruggeeft.
   */
  const numeric =
    normalized.match(
      /(?:^|\s)([0-3])(?:\s|$)/
    );

  if (numeric) {
    const value =
      Number(numeric[1]);

    if (
      Number.isInteger(value) &&
      value >= 0 &&
      value <= 3
    ) {
      return value;
    }
  }

  return null;
}

function parseDestruction(
  text: string,
): number | null {
  /*
   * Tesseract kan cijfers in Clash-resultaten
   * verwarren met letters/symbolen.
   *
   * Voorbeelden:
   *   100% -> 100%
   *   IOO% -> 100%
   *   1OO% -> 100%
   *   DO%  -> 100%
   *
   * We normaliseren alleen tokens die duidelijk
   * percentage-achtig zijn.
   */

  const normalizedText =
    text
      .replace(/[OoQq]/g, "0")
      .replace(/[IiLl|]/g, "1")
      .replace(/[Ss]/g, "5")
      .replace(/[Bb]/g, "8")
      .replace(/[Gg]/g, "6")
      .replace(/[Tt]/g, "7")
      .replace(/[Aa]/g, "4");

  const matches =
    normalizedText.match(
      /\b\d{1,3}\s*[%!]\b|\b\d{1,3}\s*[%!]/g,
    ) ?? [];

  const values = matches
    .map((value) => {
      const digits =
        value.replace(
          /[^0-9]/g,
          "",
        );

      return Number(digits);
    })
    .filter(
      (value) =>
        Number.isFinite(value) &&
        value >= 0 &&
        value <= 100,
    );

  /*
   * Tweede fallback voor OCR-varianten waarbij
   * het percentage-teken wel aanwezig is maar één
   * van de cijfers als letter is herkend.
   *
   * Bijvoorbeeld:
   *   DO% -> 100
   *   IOO% -> 100
   */
  const looseMatches =
    text.match(
      /\b[A-Za-z0-9|]{1,3}\s*%/,
    ) ?? [];

  for (
    const match of looseMatches
  ) {
    let token =
      match
        .replace(
          /\s+/g,
          "",
        )
        .replace(
          "%",
          "",
        )
        .toUpperCase();

    token =
      token
        .replace(
          /[IOQL|]/g,
          (character) =>
            character === "I" ||
            character === "L"
              ? "1"
              : "0",
        )
        .replace(
          /D/g,
          "1",
        )
        .replace(
          /S/g,
          "5",
        )
        .replace(
          /B/g,
          "8",
        )
        .replace(
          /G/g,
          "6",
        );

    /*
     * Veelvoorkomende Tesseract-fout bij Clash:
     * "100%" kan als "DO%" of "D0%" worden gelezen.
     *
     * In dat geval ontbreekt de tweede nul in de OCR.
     */
    if (
      /^(?:D0|DO)$/.test(token)
    ) {
      values.push(100);
      continue;
    }

    if (
      /^\d{1,3}$/.test(token)
    ) {
      const value =
        Number(token);

      if (
        Number.isFinite(value) &&
        value >= 0 &&
        value <= 100
      ) {
        values.push(value);
      }
    }
  }

  return values.length
    ? Math.max(...values)
    : null;
}

function parseTime(
  text: string
): number | null {
  /*
   * De screenshot wordt gemaakt op het moment dat
   * de aanval begint.
   *
   * De zichtbare Clash-tijd is daarom de totale
   * duur van de aanval.
   *
   * Voorbeeld:
   * "2M 19S" => 139 seconden
   *
   * OCR kan ook "2:19" opleveren.
   */

  const minuteSecondMatch =
    text.match(
      /(\d{1,2})\s*[mM]\s*(\d{1,2})\s*[sS]?/
    );

  if (minuteSecondMatch) {
    const minutes =
      Number(minuteSecondMatch[1]);

    const seconds =
      Number(minuteSecondMatch[2]);

    if (
      Number.isFinite(minutes) &&
      Number.isFinite(seconds) &&
      minutes >= 0 &&
      seconds >= 0 &&
      seconds <= 59
    ) {
      return (
        minutes * 60 +
        seconds
      );
    }
  }

  const colonMatch =
    text.match(
      /(\d{1,2}):(\d{2})/
    );

  if (colonMatch) {
    const minutes =
      Number(colonMatch[1]);

    const seconds =
      Number(colonMatch[2]);

    if (
      Number.isFinite(minutes) &&
      Number.isFinite(seconds) &&
      minutes >= 0 &&
      seconds >= 0 &&
      seconds <= 59
    ) {
      return (
        minutes * 60 +
        seconds
      );
    }
  }

  return null;
}


function normalizePlayerName(
  value: string,
): string {
  return value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(
      /[^a-z0-9\u0400-\u04ff]/gi,
      "",
    )
    .toLowerCase();
}

function nameSimilarity(
  a: string,
  b: string,
): number {
  const left = normalizePlayerName(a);
  const right = normalizePlayerName(b);

  if (!left || !right) {
    return 0;
  }

  if (left === right) {
    return 1;
  }

  const previous = Array.from(
    { length: right.length + 1 },
    (_, index) => index,
  );

  for (let i = 1; i <= left.length; i += 1) {
    const current = [i];

    for (let j = 1; j <= right.length; j += 1) {
      const cost =
        left[i - 1] === right[j - 1] ? 0 : 1;

      current[j] = Math.min(
        current[j - 1] + 1,
        previous[j] + 1,
        previous[j - 1] + cost,
      );
    }

    for (let j = 0; j <= right.length; j += 1) {
      previous[j] = current[j];
    }
  }

  const distance = previous[right.length];
  const longestLength = Math.max(
    left.length,
    right.length,
  );

  return longestLength === 0
    ? 0
    : 1 - distance / longestLength;
}

function namesArePotentiallyTheSameAccount(
  a: string,
  b: string,
): boolean {
  const left = normalizePlayerName(a);
  const right = normalizePlayerName(b);

  if (left.length < 4 || right.length < 4) {
    return false;
  }

  if (left === right) {
    return true;
  }

  if (
    left.includes(right) ||
    right.includes(left)
  ) {
    return true;
  }

  return nameSimilarity(left, right) >= 0.8;
}

function findPlayerNameLines(
  text: string,
): string[] {
  return text
    .split(/\r?\n/)
    .map((line) =>
      line
        .trim()
        .replace(/\s+/g, " "),
    )
    .filter(
      (line) =>
        line.length >= 2 &&
        line.length <= 32,
    );
}

function looksLikeClashResult(
  text: string,
  townHall: number
): boolean {
  const normalized =
    text.toLowerCase();

  const indicators = [
    "stars",
    "star",
    "victory",
    "defeat",
    "percentage",
    "damage",
    "destruction",
    "%",
  ];

  const matches =
    indicators.filter(
      (indicator) =>
        normalized.includes(indicator)
    );

  const townHallDetected =
    normalized.includes(
      `th${townHall}`
    ) ||
    normalized.includes(
      `town hall ${townHall}`
    ) ||
    normalized.includes(
      `townhall ${townHall}`
    );

  return (
    matches.length >= 2 ||
    (
      townHallDetected &&
      matches.length >= 1
    )
  );
}

export const maxDuration = 300;

export async function POST(
  request: Request
) {
  try {
    const formData =
      await request.formData();

    const challengeIdValue =
      formData.get("challengeId");

    const difficultyValue =
      formData.get("difficulty");

    const screenshot =
      formData.get("screenshot");

    const challengeId =
      typeof challengeIdValue === "string"
        ? Number(
            challengeIdValue,
          )
        : NaN;

    const difficulty =
      typeof difficultyValue === "string"
        ? difficultyValue.trim()
        : "";

    if (
      !Number.isInteger(
        challengeId,
      ) ||
      challengeId <= 0
    ) {
      return NextResponse.json(
        {
          success: false,
          error:
            "De Challenge kon niet worden bepaald.",
        },
        { status: 400 }
      );
    }

    if (
      !difficulty
    ) {
      return NextResponse.json(
        {
          success: false,
          error:
            "De gekozen moeilijkheid kon niet worden bepaald.",
        },
        { status: 400 }
      );
    }

    if (
      !screenshot ||
      !(screenshot instanceof File)
    ) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Een screenshot is verplicht.",
        },
        { status: 400 }
      );
    }

    if (
      !screenshot.type.startsWith(
        "image/"
      )
    ) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Het bestand moet een afbeelding zijn.",
        },
        { status: 400 }
      );
    }

    const MAX_FILE_SIZE =
      10 * 1024 * 1024;

    if (
      screenshot.size >
      MAX_FILE_SIZE
    ) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Het screenshot mag maximaal 10 MB zijn.",
        },
        { status: 400 }
      );
    }

    const now =
      new Date();

    /*
     * Zoek exact de Challenge die vanuit de
     * pagina is meegestuurd.
     *
     * Niet meer:
     * "pak maar de laatste actieve Challenge".
     */
    const challenge =
      await prisma.randomChallenge.findFirst({
        where: {
          id:
            challengeId,
          status:
            "ACTIVE",
          startsAt: {
            lte: now,
          },
          endsAt: {
            gt: now,
          },
        },
      });

    if (!challenge) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Deze Challenge is niet meer actief of bestaat niet.",
        },
        { status: 409 }
      );
    }

    /*
     * Zoek exact de gekozen variant binnen
     * deze Challenge.
     */
    const variant =
      await prisma.randomChallengeVariant.findUnique({
        where: {
          challengeId_difficulty: {
            challengeId:
              challenge.id,
            difficulty,
          },
        },
      });

    if (!variant) {
      return NextResponse.json(
        {
          success: false,
          error:
            "De gekozen army-variant bestaat niet binnen deze Challenge.",
        },
        { status: 400 }
      );
    }

    const imageBuffer =
      Buffer.from(
        await screenshot.arrayBuffer()
      );

    const fs =
      await import("node:fs/promises");

    const path =
      await import("node:path");

    const crypto =
      await import("node:crypto");

    const uploadDirectory =
      path.join(
        process.cwd(),
        "public",
        "uploads",
        "random-challenge",
        String(challenge.id),
      );

    await fs.mkdir(
      uploadDirectory,
      { recursive: true },
    );

    const extension =
      screenshot.type === "image/png"
        ? "png"
        : screenshot.type === "image/webp"
          ? "webp"
          : "jpg";

    const filename =
      `${crypto.randomUUID()}.${extension}`;

    const screenshotFile =
      path.join(
        uploadDirectory,
        filename,
      );

    await fs.writeFile(
      screenshotFile,
      imageBuffer,
    );

    const screenshotPath =
      `/uploads/random-challenge/${challenge.id}/${filename}`;

    /*
     * De upload is nu veilig opgeslagen.
     *
     * Vanaf hier mag de browser niet meer hoeven
     * wachten op OCR, spelerkoppeling of ranking.
     */
    const processingEntry =
      await prisma.randomChallengeEntry.create({
        data: {
          challengeId:
            challenge.id,

          playerTag:
            `UPLOAD:${filename}`,

          playerName:
            "Wordt verwerkt",

          difficulty,

          screenshotPath,

          status:
            "PROCESSING",

          ocrResult: {
            processingStatus:
              "QUEUED",
          },

          adminNote:
            "Phoenix verwerkt deze inzending.",
        },
      });

    after(async () => {
    const worker =
      await createWorker("eng", 1, {
        workerPath: path.join(
          process.cwd(),
          "node_modules",
          "tesseract.js",
          "src",
          "worker-script",
          "node",
          "index.js",
        ),
      });

    /*
     * ---------------------------------------------------------
     * SLIMME OCR
     *
     * We gaan niet uit van een vaste verticale positie van
     * het chatresultaat.
     *
     * 1. Hele screenshot lezen met bounding boxes.
     * 2. Rechtsboven bepalen we de aanvaller.
     * 3. In het linkerpaneel zoeken we naar de FC-regel
     *    die bij deze aanvaller hoort.
     * 4. Alleen rond die gevonden regel lezen we sterren/%.
     * 5. Tijd komt uit de vaste midden-onder zone.
     *
     * De originele screenshot blijft volledig intact.
     * ---------------------------------------------------------
     */

    function getJpegDimensions(
      buffer: Buffer,
    ): {
      width: number;
      height: number;
    } {
      if (
        buffer.length >= 2 &&
        buffer[0] === 0xff &&
        buffer[1] === 0xd8
      ) {
        let index = 2;

        while (
          index + 9 <
          buffer.length
        ) {
          if (
            buffer[index] !== 0xff
          ) {
            index += 1;
            continue;
          }

          const marker =
            buffer[index + 1];

          index += 2;

          if (
            marker === 0xd8 ||
            marker === 0xd9
          ) {
            continue;
          }

          if (
            index + 1 >=
            buffer.length
          ) {
            break;
          }

          const segmentLength =
            buffer.readUInt16BE(
              index,
            );

          if (
            marker >= 0xc0 &&
            marker <= 0xcf &&
            ![
              0xc4,
              0xc8,
              0xcc,
            ].includes(marker)
          ) {
            return {
              height:
                buffer.readUInt16BE(
                  index + 3,
                ),
              width:
                buffer.readUInt16BE(
                  index + 5,
                ),
            };
          }

          index += segmentLength;
        }
      }

      /*
       * De huidige Challenge-screenshots zijn 2340x1080.
       * Alleen onbekende afbeeldingsformaten vallen hierop
       * terug.
       */
      return {
        width: 2340,
        height: 1080,
      };
    }

    const imageDimensions =
      getJpegDimensions(
        imageBuffer,
      );

    const imageWidth =
      imageDimensions.width;

    const imageHeight =
      imageDimensions.height;

    /*
     * Rechterbovenhoek:
     * de test op de echte screenshot liet zien dat deze
     * compacte zone "TDG Maarten" betrouwbaar uitleest.
     */
    const rightTopZone = {
      left: 1750,
      top: 0,
      width: Math.min(
        550,
        imageWidth - 1750,
      ),
      height: Math.min(
        190,
        imageHeight,
      ),
    };

    const timeZone = {
      left:
        Math.round(
          imageWidth * 0.34,
        ),
      top:
        Math.round(
          imageHeight * 0.62,
        ),
      width:
        Math.round(
          imageWidth * 0.34,
        ),
      height:
        Math.round(
          imageHeight * 0.30,
        ),
    };

    /*
     * Het volledige linkerpaneel.
     * Geen vaste Y-positie: de chat mag zo veel scrollen
     * als nodig is.
     */
    const chatZone = {
      left: 0,
      top: 0,
      width:
        Math.round(
          imageWidth * 0.35,
        ),
      height:
        imageHeight,
    };

    /*
     * We halen de bestaande spelersnamen al op voordat we
     * de chat analyseren. De OCR-naam rechtsboven wordt
     * eerst gekoppeld aan deze tabel. Daarna gebruiken we
     * de echte database-naam als anker voor de chat.
     */
    const rawPlayers =
      await prisma.player.findMany({
        select: {
          playerTag: true,
          currentName: true,
        },
      });

    /*
     * Sommige syncs hebben dezelfde Clash-account zowel met
     * als zonder "#" opgeslagen. Voor OCR-koppeling moeten
     * die als één account worden behandeld.
     */
    const playersByCanonicalTag =
      new Map<
        string,
        {
          playerTag: string;
          currentName: string;
        }
      >();

    for (
      const player of rawPlayers
    ) {
      const canonicalTag =
        player.playerTag
          .trim()
          .replace(/^#/, "")
          .toUpperCase();

      if (
        !canonicalTag
      ) {
        continue;
      }

      const existing =
        playersByCanonicalTag.get(
          canonicalTag,
        );

      /*
       * Geef de variant mét # de voorkeur als beide bestaan.
       */
      if (
        !existing ||
        (
          player.playerTag.startsWith("#") &&
          !existing.playerTag.startsWith("#")
        )
      ) {
        playersByCanonicalTag.set(
          canonicalTag,
          {
            playerTag:
              player.playerTag,
            currentName:
              player.currentName,
          },
        );
      }
    }

    const players =
      Array.from(
        playersByCanonicalTag.values(),
      );

    let nameText = "";
    let timeText = "";
    let chatText = "";
    let resultFocusText = "";
    let starsOcrText = "";
    let percentageOcrText = "";
    let resultTimeOcrText = "";
    let matchedChatLineText = "";
    let attackerPlayer:
      | {
          playerTag: string;
          currentName: string;
        }
      | null = null;

    let bestMatchedPlayer:
      | {
          playerTag: string;
          currentName: string;
        }
      | null = null;

    let bestPlayerScore = 0;

    let exactPlayerNameMatches: Array<{
      playerTag: string;
      currentName: string;
    }> = [];

    try {
      /*
       * -------------------------------------------------------
       * 1. AANVALLER RECHTSBOVEN
       * -------------------------------------------------------
       */
      await worker.setParameters({
        tessedit_pageseg_mode:
          PSM.SPARSE_TEXT,
        tessedit_char_whitelist:
          "",
      });

      const nameOcr =
        await worker.recognize(
          imageBuffer,
          {
            rectangle:
              rightTopZone,
          },
          {
            blocks: true,
          },
        );

      nameText =
        nameOcr.data.text;

      /*
       * -------------------------------------------------------
       * 1B. OCR-NAAM -> BESTAANDE PLAYER
       * -------------------------------------------------------
       *
       * We gebruiken niet langer willekeurige OCR-regels
       * als zoekanker voor de chat.
       *
       * Eerst bepalen we welke bestaande speler het best
       * overeenkomt met de naam rechtsboven.
       */
      const nameCandidates =
        nameText
          .split(/\r?\n/)
          .map((line) =>
            line
              .trim()
              .replace(/\s+/g, " "),
          )
          .filter(
            (line) =>
              normalizePlayerName(
                line,
              ).length >= 3,
          );

      /*
       * Eerst zoeken we uitsluitend naar een EXACTE
       * genormaliseerde naam.
       *
       * Voorbeeld:
       *   "TDG Maarten" -> "tdgmaarten"
       *   "TDG Maarten" -> "tdgmaarten"
       *
       * # voor Clash-tags is al eerder verwijderd uit
       * de canonicalisatie van players.
       */
      exactPlayerNameMatches =
        players.filter(
          (player) => {
            const playerNormalized =
              normalizePlayerName(
                player.currentName,
              );

            return nameCandidates.some(
              (candidate) =>
                normalizePlayerName(
                  candidate,
                ) ===
                playerNormalized,
            );
          },
        );

      bestPlayerScore = 0;
      attackerPlayer = null;

      /*
       * EXACT ÉÉN ACCOUNT
       */
      if (
        exactPlayerNameMatches.length === 1
      ) {
        attackerPlayer =
          exactPlayerNameMatches[0];

        bestPlayerScore = 1;
      }

      /*
       * MEERDERE EXACTE ACCOUNTS
       *
       * Bijvoorbeeld twee verschillende accounts met:
       * "Guus T"
       *
       * NOOIT gokken.
       */
      else if (
        exactPlayerNameMatches.length > 1
      ) {
        attackerPlayer = null;
        bestPlayerScore = 0;
      }

      /*
       * GEEN EXACTE MATCH
       *
       * Alleen hier gebruiken we fuzzy matching als hulpmiddel.
       * Er wordt alleen automatisch gekozen wanneer één kandidaat
       * duidelijk beter is dan alle andere kandidaten.
       */
      else {
        const fuzzyCandidates =
          players
            .map((player) => {
              const playerName =
                normalizePlayerName(
                  player.currentName,
                );

              let score = 0;

              for (
                const candidate of
                  nameCandidates
              ) {
                const normalizedCandidate =
                  normalizePlayerName(
                    candidate,
                  );

                if (
                  normalizedCandidate.length <
                    4 ||
                  playerName.length <
                    4
                ) {
                  continue;
                }

                score =
                  Math.max(
                    score,
                    nameSimilarity(
                      normalizedCandidate,
                      playerName,
                    ),
                  );
              }

              return {
                player,
                score,
              };
            })
            .filter(
              (candidate) =>
                candidate.score >=
                0.93,
            )
            .sort(
              (a, b) =>
                b.score -
                a.score,
            );

        const first =
          fuzzyCandidates[0];

        const second =
          fuzzyCandidates[1];

        /*
         * Alleen een duidelijke fuzzy winnaar mag automatisch
         * worden gebruikt.
         */
        if (
          first &&
          (
            !second ||
            first.score -
              second.score >=
              0.05
          )
        ) {
          attackerPlayer =
            first.player;

          bestPlayerScore =
            first.score;
        }
      }

      /*
       * -------------------------------------------------------
       * 2. TIJD MIDDEN ONDER
       * -------------------------------------------------------
       */
      await worker.setParameters({
        tessedit_pageseg_mode:
          PSM.SINGLE_LINE,
        tessedit_char_whitelist:
          "0123456789mMsS:",
      });

      const timeOcr =
        await worker.recognize(
          imageBuffer,
          {
            rectangle:
              timeZone,
          },
        );

      timeText =
        timeOcr.data.text;

      /*
       * -------------------------------------------------------
       * 3. VOLLEDIGE CHAT MET POSITIES
       * -------------------------------------------------------
       */
      await worker.setParameters({
        tessedit_pageseg_mode:
          PSM.SPARSE_TEXT,
        tessedit_char_whitelist:
          "",
      });

      const chatOcr =
        await worker.recognize(
          imageBuffer,
          {
            rectangle:
              chatZone,
          },
          {
            blocks: true,
          },
        );

      chatText =
        chatOcr.data.text;

      type OcrLine = {
        text: string;
        x0: number;
        x1: number;
        y0: number;
        y1: number;
      };

      const chatLines: OcrLine[] = [];

      /*
       * Tesseract 7 levert de structuur:
       * blocks -> paragraphs -> lines -> words.
       */
      for (
        const block of
          chatOcr.data.blocks ?? []
      ) {
        for (
          const paragraph of
            block.paragraphs ?? []
        ) {
          for (
            const line of
              paragraph.lines ?? []
          ) {
            const lineText =
              line.text
                .replace(
                  /\s+/g,
                  " ",
                )
                .trim();

            if (
              !lineText ||
              !line.bbox
            ) {
              continue;
            }

            chatLines.push({
              text:
                lineText,
              x0:
                line.bbox.x0,
              x1:
                line.bbox.x1,
              y0:
                line.bbox.y0,
              y1:
                line.bbox.y1,
            });
          }
        }
      }

      /*
       * -------------------------------------------------------
       * 4. AANVALLER ALS CHAT-ANKER
       * -------------------------------------------------------
       *
       * De speler rechtsboven is nu gekoppeld aan de
       * bestaande Player-tabel.
       *
       * Vanaf hier gebruiken we uitsluitend deze echte
       * database-naam om de juiste FC-regel te vinden.
       */
      /*
       * -------------------------------------------------------
       * 4. FC-ZOEKER: ONDERSTE 40% VAN DE CHAT
       * -------------------------------------------------------
       *
       * We zoeken de onderste FC-kaart via een dubbele bekende
       * spelersnaam. De OCR van Tesseract kan pijlen en quotes
       * beschadigen, daarom is een pijl GEEN harde voorwaarde.
       *
       * Voorbeeld:
       *   TDG Maarten “* TDG Maarten
       *
       * Alleen de onderste 40% van het screenshot telt.
       * Bij meerdere kandidaten wint de laagst gelegen regel.
       */

      let bestLine:
        | OcrLine
        | null = null;

      let bestMatchedPlayer:
        | {
            playerTag: string;
            currentName: string;
          }
        | null = null;

      let bestLineScore = -1;

      const lowerChatTop =
        Math.round(
          imageHeight * 0.60,
        );

      for (
        const line of chatLines
      ) {
        /*
         * Alleen onderste 40% van het volledige screenshot.
         */
        if (
          line.y1 <
          lowerChatTop
        ) {
          continue;
        }

        const lineNormalized =
          normalizePlayerName(
            line.text,
          );

        if (
          lineNormalized.length < 4
        ) {
          continue;
        }

        let lineBestPlayer:
          | {
              playerTag: string;
              currentName: string;
            }
          | null = null;

        let lineBestOccurrences = 0;
        let lineBestNameLength = 0;

        for (
          const player of players
        ) {
          const playerNameNormalized =
            normalizePlayerName(
              player.currentName,
            );

          if (
            playerNameNormalized.length < 4
          ) {
            continue;
          }

          /*
           * Hoe vaak komt deze bekende spelersnaam in
           * dezelfde OCR-regel voor?
           *
           * "tdgmaartentdgmaarten" => 2
           */
          const occurrences =
            lineNormalized
              .split(
                playerNameNormalized,
              ).length - 1;

          if (
            occurrences >= 2
          ) {
            if (
              occurrences >
                lineBestOccurrences ||
              (
                occurrences ===
                  lineBestOccurrences &&
                playerNameNormalized.length >
                  lineBestNameLength
              )
            ) {
              lineBestPlayer =
                player;

              lineBestOccurrences =
                occurrences;

              lineBestNameLength =
                playerNameNormalized.length;
            }
          }
        }

        /*
         * Geen dubbele bekende naam = geen FC-kandidaat.
         */
        if (
          !lineBestPlayer ||
          lineBestOccurrences < 2
        ) {
          continue;
        }

        /*
         * Sterke basisscore voor dubbele naam.
         */
        let score =
          1000 +
          lineBestOccurrences * 100 +
          lineBestNameLength;

        /*
         * Een pijl of pijlachtige separator is extra bewijs,
         * maar absoluut niet verplicht.
         */
        if (
          /(?:→|->|=>|>|“|”)/.test(
            line.text,
          )
        ) {
          score += 100;
        }

        /*
         * Percentage op dezelfde OCR-regel is extra bewijs.
         */
        if (
          /\d+(?:[.,]\d+)?\s*[%!]/.test(
            line.text,
          )
        ) {
          score += 100;
        }

        /*
         * Belangrijkste selectiecriterium:
         * de laagst gelegen dubbele-naamregel wint.
         *
         * We gebruiken y1 als tie-breaker, zodat een eerdere
         * 100%-regel hoger in de chat nooit geselecteerd wordt.
         */
        const isBetter =
          bestLine === null ||
          score > bestLineScore ||
          (
            score === bestLineScore &&
            line.y1 > bestLine.y1
          );

        if (
          isBetter
        ) {
          bestLine =
            line;

          bestLineScore =
            score;

          bestMatchedPlayer =
            lineBestPlayer;
        }
      }

      /*
       * -------------------------------------------------------
       * 5. LOKALE RESULTAATZONE
       * -------------------------------------------------------
       *
       * Alleen rondom de geselecteerde FC-regel zoeken.
       *
       * We beginnen exact op/rond de FC-regel en kijken een
       * relatieve afstand naar beneden. Hierdoor valt een
       * eerdere 100% in een andere chatkaart buiten de zone.
       */
      if (
        bestLine
      ) {
        matchedChatLineText =
          bestLine.text;

        const localTop =
          Math.max(
            lowerChatTop,
            Math.round(
              bestLine.y0 -
              imageHeight * 0.01,
            ),
          );

        const localBottom =
          Math.min(
            imageHeight,
            Math.round(
              bestLine.y1 +
              imageHeight * 0.15,
            ),
          );

        const resultFocusZone = {
          left: 0,
          top:
            localTop,
          width:
            Math.round(
              imageWidth * 0.35,
            ),
          height:
            Math.max(
              Math.round(
                imageHeight * 0.10,
              ),
              localBottom -
                localTop,
            ),
        };

        /*
         * ---------------------------------------------------
         * 5A. PERCENTAGE OCR
         * ---------------------------------------------------
         */
        await worker.setParameters({
          tessedit_pageseg_mode:
            PSM.SPARSE_TEXT,
          tessedit_char_whitelist:
            "0123456789.,%!",
        });

        const percentageOcr =
          await worker.recognize(
            imageBuffer,
            {
              rectangle:
                resultFocusZone,
            },
          );

        percentageOcrText =
          percentageOcr.data.text;

        /*
         * ---------------------------------------------------
         * 5B. STERREN OCR
         * ---------------------------------------------------
         */
        await worker.setParameters({
          tessedit_pageseg_mode:
            PSM.SPARSE_TEXT,
          tessedit_char_whitelist:
            "0123★⭐*☆",
        });

        const starsOcr =
          await worker.recognize(
            imageBuffer,
            {
              rectangle:
                resultFocusZone,
            },
          );

        starsOcrText =
          starsOcr.data.text;

        /*
         * ---------------------------------------------------
         * 5C. TIJD OCR
         * ---------------------------------------------------
         */
        await worker.setParameters({
          tessedit_pageseg_mode:
            PSM.SPARSE_TEXT,
          tessedit_char_whitelist:
            "0123456789mMsS:",
        });

        const resultTimeOcr =
          await worker.recognize(
            imageBuffer,
            {
              rectangle:
                resultFocusZone,
            },
          );

        resultTimeOcrText =
          resultTimeOcr.data.text;

        resultFocusText =
          [
            "[PERCENTAGE]",
            percentageOcrText.trim(),
            "",
            "[STERREN]",
            starsOcrText.trim(),
            "",
            "[TIJD]",
            resultTimeOcrText.trim(),
          ].join("\n");
      }

    } finally {
      await worker.terminate();
    }

    /*
     * Voor admin/debugging bewaren we welke OCR-bronnen
     * Phoenix heeft gebruikt.
     */
    const ocrText =
      [
        "[NAAM RECHTSBOVEN]",
        nameText.trim(),
        "",
        "[TIJD]",
        timeText.trim(),
        "",
        "[GEVONDEN CHATREGEL]",
        matchedChatLineText.trim(),
        "",
        "[RESULTAATZONE]",
        resultFocusText.trim(),
        "",
        "[PERCENTAGE OCR]",
        percentageOcrText.trim(),
        "",
        "[STERREN OCR]",
        starsOcrText.trim(),
        "",
        "[TIJD RESULTAATZONE OCR]",
        resultTimeOcrText.trim(),
        "",
        "[VOLLEDIGE CHAT OCR]",
        chatText.trim(),
      ].join("\n");

    let stars =
      parseStars(
        starsOcrText,
      );

    let destruction =
      parseDestruction(
        percentageOcrText,
      );

    /*
     * Clash-resultaatregel met 100% = altijd 3 sterren.
     * Dit blijft onze afgesproken backup/validatieregel.
     *
     * Omdat destruction nu uitsluitend uit de lokale
     * geselecteerde FC-zone komt, kan een eerdere 100% elders
     * in de chat deze waarde niet meer beïnvloeden.
     */
    if (
      destruction === 100
    ) {
      stars = 3;
    }

    /*
     * Vision AI mag de lokale OCR-resultaatzone NIET overschrijven.
     *
     * De screenshot kan meerdere FC-resultaten bevatten.
     * Daarom gebruiken we Vision alleen voor logging/debugging.
     */
    const visionAnalysis =
      await analyzeChallengeScreenshot(
        screenshotFile,
      );

    const visionResult =
      visionAnalysis.result;

    const timeSeconds =
      parseTime(
        resultTimeOcrText,
      ) ??
      parseTime(
        timeText,
      );

    const clashResultDetected =
      stars !== null &&
      destruction !== null;

    /*
     * Probeer de spelernaam uit de OCR te koppelen
     * aan de bestaande Player-tabel.
     *
     * We gebruiken daarbij alleen de genormaliseerde
     * letters/cijfers. Accenten, emoji's en leestekens
     * worden genegeerd omdat OCR daar onbetrouwbaar
     * mee kan omgaan.
     */
    const ocrLines =
      findPlayerNameLines(
        [
          nameText,
          matchedChatLineText,
          resultFocusText,
        ].join("\n"),
      );

    /*
     * ---------------------------------------------------------
     * DEFINITIEVE ACCOUNTIDENTITEIT
     * ---------------------------------------------------------
     *
     * Exact één account:
     *   -> UNIQUE
     *
     * Meerdere accounts met exact dezelfde naam:
     *   -> AMBIGUOUS
     *
     * Geen exacte naam maar één duidelijke fuzzy kandidaat:
     *   -> UNIQUE
     *
     * Anders:
     *   -> NOT_FOUND
     */
    const playerNameMatchStatus =
      bestMatchedPlayer
        ? "UNIQUE"
        : exactPlayerNameMatches.length > 1
          ? "AMBIGUOUS"
          : "NOT_FOUND";

    const playerNameMatch =
      bestMatchedPlayer as
        | {
            playerTag: string;
            currentName: string;
          }
        | null;


    const playerNameReviewRequired =
      playerNameMatch === null;

    const playerMatches =
      playerNameMatch
        ? [playerNameMatch]
        : exactPlayerNameMatches;

    const matchedPlayerTag =
      playerNameMatch?.playerTag ?? null;

    const matchedPlayerName =
      playerNameMatch?.currentName ??
      ocrLines.find((line) =>
        playerMatches.some(
          (player) =>
            player.currentName ===
            line,
        ),
      ) ??
      ocrLines[0] ??
      null;

    const screenshotDetected =
      clashResultDetected &&
      stars !== null &&
      destruction !== null;

    const validation =
      validateChallengeResult({
        stars:
          stars ?? -1,
        destruction:
          destruction ?? -1,
        timeSeconds,
        screenshotDetected,
      });

    const finalPlayerTag =
      matchedPlayerTag ??
      `OCR:${normalizePlayerName(
        matchedPlayerName ??
          "unknown",
      )}`;

    /*
     * Een speler mag binnen dezelfde Challenge en difficulty
     * maar één inzending hebben.
     *
     * De huidige verwerking heeft tijdelijk een UPLOAD:-tag.
     * Zodra OCR een echte speler oplevert, kan er al een oudere
     * inzending van diezelfde speler bestaan.
     *
     * In dat geval vervangen we de oude inzending door deze
     * nieuwste verwerking. De gekoppelde RandomChallengeResult
     * wordt door onDelete: Cascade automatisch verwijderd en
     * hieronder opnieuw aangemaakt wanneer de nieuwe score geldig is.
     */
    const existingEntry =
      await prisma.randomChallengeEntry.findFirst({
        where: {
          challengeId:
            challenge.id,

          playerTag:
            finalPlayerTag,

          difficulty:
            variant.difficulty,

          NOT: {
            id:
              processingEntry.id,
          },
        },

        select: {
          id: true,
        },
      });

    if (
      existingEntry
    ) {
      await prisma.randomChallengeEntry.delete({
        where: {
          id:
            existingEntry.id,
        },
      });
    }

    const entry =
      await prisma.randomChallengeEntry.update({
        where: {
          id:
            processingEntry.id,
        },

        data: {
          playerTag:
            finalPlayerTag,

          playerName:
            matchedPlayerName ??
            "Onbekende speler",

          status:
            validation.needsReview ||
            playerNameReviewRequired
              ? "PENDING"
              : "APPROVED",

          ocrResult: {
            text:
              ocrText,

            clashResultDetected,

            stars,

            destruction,

            timeSeconds,

            selectedDifficulty:
              variant.difficulty,

            selectedVariantId:
              variant.id,

            sourceArmyId:
              variant.sourceArmyId,

            sourceArmyName:
              variant.sourceArmyName,

            playerNameMatchStatus,

            playerNameFromDatabase:
              playerNameMatch?.currentName ??
              null,

            playerNameFromScreenshot:
              nameText
                .split(/\r?\n/)
                .map((line) =>
                  line.trim(),
                )
                .filter(Boolean)[0] ??
              null,

            playerNameMatchedAccount:
              playerNameMatch?.currentName ??
              null,

            playerNameCandidates:
              playerMatches.map(
                (player) => ({
                  playerTag:
                    player.playerTag,
                  currentName:
                    player.currentName,
                }),
              ),

            validation,

            processingStatus:
              "COMPLETED",

            vision: {
              model:
                visionAnalysis.model,

              result:
                visionAnalysis.result,

              raw:
                visionAnalysis.raw,

              error:
                visionAnalysis.error,
            },
          },

          adminNote:
            playerNameReviewRequired
              ? `${validation.reason} Spelernaam kon niet eenduidig automatisch worden gekoppeld (${playerNameMatchStatus}).`
              : validation.reason,

          reviewedAt:
            validation.needsReview ||
            playerNameReviewRequired
              ? null
              : new Date(),
        },
      });

    if (
      validation.valid &&
      !playerNameReviewRequired
    ) {
      await prisma.randomChallengeResult.create({
        data: {
          entryId:
            entry.id,

          stars:
            stars!,

          destruction:
            destruction!,

          timeSeconds,

          score:
            validation.score,

          randomChallengeId:
            challenge.id,
        },
      });

      await recalculateChallengeRanking(
        challenge.id,
        variant.difficulty,
      );
    }

    const response = NextResponse.json({
      success:
        true,

      status:
        entry.status,

      stars,

      destruction,

      timeSeconds,

      score:
        validation.valid
          ? validation.score
          : null,

      selectedDifficulty:
        variant.difficulty,

      selectedVariantId:
        variant.id,

      needsReview:
        validation.needsReview ||
        playerNameReviewRequired,

      playerNameMatchStatus,

      matchedPlayer:
        playerNameMatch
          ? {
              playerTag:
                playerNameMatch.playerTag,
              currentName:
                playerNameMatch.currentName,
            }
          : null,

      message:
        validation.needsReview ||
        playerNameReviewRequired
          ? "🟡 Inzending ontvangen. Phoenix controleert deze."
          : "🟢 Phoenix heeft je resultaat automatisch gevalideerd!",
    });

    /*
     * Wanneer Phoenix de spelernaam automatisch
     * aan een bestaande Player heeft gekoppeld,
     * onthouden we de playerTag in een cookie.
     *
     * De cookie wordt alleen gebruikt om de eigen
     * positie op het publieke leaderboard te tonen.
     * De ranking zelf komt altijd uit de database.
     */
    if (playerNameMatch?.playerTag) {
      response.cookies.set(
        "tdg_challenge_player_tag",
        playerNameMatch.playerTag,
        {
          httpOnly: true,
          sameSite: "lax",
          secure:
            process.env.NODE_ENV ===
            "production",
          path: "/",
          maxAge:
            60 * 60 * 24 * 30,
        },
      );
    }

    });

    return NextResponse.json({
      success: true,
      status: "PROCESSING",
      message:
        "✅ Screenshot ontvangen. Phoenix verwerkt je inzending op de achtergrond.",
    });
  } catch (error) {
    console.error(
      "Challenge OCR submission error:",
      error
    );

    return NextResponse.json(
      {
        success:
          false,

        error:
          "Phoenix kon het screenshot niet verwerken.",
      },
      { status: 500 }
    );
  }
}

