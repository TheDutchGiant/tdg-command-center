generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Base {
  id          Int      @id @default(autoincrement())
  townHall    Int
  category    String
  name        String
  description String?
  baseLink    String
  createdBy   String
  createdAt   DateTime @default(now())
}