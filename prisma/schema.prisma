generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Base {
  id          Int      @id @default(autoincrement())
  townHall    Int
  category    String
  name        String
  description String?
  baseLink    String
  createdBy   String
  createdAt   DateTime @default(now())
}

model Clan {
  id        Int      @id @default(autoincrement())
  name      String
  tag       String   @unique
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())
  seasons   Season[]
  wars      War[]
}

model Season {
  id        Int      @id @default(autoincrement())
  clanId    Int
  season    String
  createdAt DateTime @default(now())
  clan      Clan     @relation(fields: [clanId], references: [id])
  wars      War[]

  @@unique([clanId, season])
}

model War {
  warTag               String   @id
  seasonId             Int
  clanId               Int
  round                Int
  state                 String
  teamSize             Int
  preparationStartTime DateTime
  warStartTime         DateTime
  warEndTime           DateTime
  clanStars             Int
  opponentStars         Int
  clanDestruction       Float
  opponentDestruction   Float
  importedAt            DateTime @default(now())
  lastSyncedAt          DateTime @default(now())
  isFinalized           Boolean  @default(false)
  attacks               Attack[]
  clan                  Clan     @relation(fields: [clanId], references: [id])
  season                Season   @relation(fields: [seasonId], references: [id])
}

model Player {
  playerTag   String        @id
  currentName String
  createdAt   DateTime      @default(now())
  attacks     Attack[]
  events      CareerEvent[]
}

model Attack {
  id                      Int    @id @default(autoincrement())
  warTag                  String
  playerTag               String
  defenderTag             String
  defenderName            String
  warDay                  Int
  attackNumber            Int
  stars                   Int
  destruction             Int
  duration                Int
  attackerTownHall        Int
  defenderTownHall        Int
  defenseStars            Int
  defenseDestruction      Int
  defenseAttackerTownHall Int
  player                  Player @relation(fields: [playerTag], references: [playerTag])
  war                     War    @relation(fields: [warTag], references: [warTag])
}

model CareerEvent {
  id          Int      @id @default(autoincrement())
  playerTag   String
  date        DateTime
  type        String
  description String
  createdBy   String
  player      Player   @relation(fields: [playerTag], references: [playerTag])
}

model ImportLog {
  id              Int       @id @default(autoincrement())
  season          String
  startedAt       DateTime
  finishedAt      DateTime?
  warsImported    Int
  attacksImported Int
  success         Boolean
  error           String?
  createdAt       DateTime  @default(now())
  successfulSync  Boolean   @default(false)
}

model SystemState {
  id            Int       @id @default(1)
  mode          String     @default("IDLE")
  currentSeason String?
  lastCheck     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model CwlMatchup {
  id               Int       @id @default(autoincrement())
  season           String
  round            Int
  warTag           String    @unique
  warSize          Int?
  clanATag         String
  clanAName        String
  clanAStars       Int       @default(0)
  clanADestruction Float     @default(0)
  clanABonusStars  Int       @default(0)
  clanAResult      String?
  clanAIsTDG       Boolean   @default(false)
  clanBTag         String
  clanBName         String
  clanBStars       Int       @default(0)
  clanBDestruction Float     @default(0)
  clanBBonusStars  Int       @default(0)
  clanBResult      String?
  clanBIsTDG       Boolean   @default(false)
  status           String?
  endTime          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

model AdminUser {
  id           Int                    @id @default(autoincrement())
  username     String                 @unique
  passwordHash String
  role         AdminRole              @default(ADMIN)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  sessions     AdminSession[]
  auditLogs    AuditLog[]
  permissions  AdminUserPermission[]
}

model AdminPermission {
  id          Int                    @id @default(autoincrement())
  key         String                 @unique
  name        String
  description String?
  createdAt   DateTime               @default(now())
  admins      AdminUserPermission[]
}

model AdminUserPermission {
  id           Int             @id @default(autoincrement())
  adminId      Int
  permissionId Int
  createdAt    DateTime        @default(now())

  admin        AdminUser       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([adminId, permissionId])
  @@index([adminId])
  @@index([permissionId])
}

model AdminSession {
  id         String    @id
  adminId    Int
  deviceId   String
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  adminId     Int
  action      String
  targetType  String?
  targetId    String?
  details     String?
  createdAt   DateTime  @default(now())

  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([createdAt])
}

model MissedAttack {
  id              Int      @id @default(autoincrement())
  clanTag         String
  warTag          String
  playerTag       String
  playerName      String
  missedAttacks   Int
  warEndTime      DateTime
  createdAt       DateTime @default(now())

  @@index([clanTag])
  @@index([playerTag])
  @@index([warTag])
  @@index([createdAt])
}