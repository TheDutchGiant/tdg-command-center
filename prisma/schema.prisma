generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Base {
  id               Int               @id @default(autoincrement())
  townHall         Int
  category         String
  name             String
  description      String?
  baseLink         String
  imageUrl         String?
  createdBy        String
  createdAt        DateTime          @default(now())
  expiresAt        DateTime?
  isActive         Boolean           @default(false)
  randomChallenges RandomChallenge[]

  @@index([townHall, isActive])
  @@index([expiresAt])
}

model Clan {
  id        Int      @id @default(autoincrement())
  name      String
  tag       String   @unique
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())
  seasons   Season[]
  wars      War[]
}

model Season {
  id        Int      @id @default(autoincrement())
  clanId    Int
  season    String
  createdAt DateTime @default(now())
  clan      Clan     @relation(fields: [clanId], references: [id])
  wars      War[]

  @@unique([clanId, season])
}

model War {
  warTag               String   @id
  seasonId             Int
  clanId               Int
  round                Int
  state                String
  teamSize             Int
  preparationStartTime DateTime
  warStartTime         DateTime
  warEndTime           DateTime
  clanStars            Int
  opponentStars        Int
  clanDestruction      Float
  opponentDestruction  Float
  importedAt           DateTime @default(now())
  lastSyncedAt         DateTime @default(now())
  isFinalized          Boolean  @default(false)
  attacks              Attack[]
  clan                 Clan     @relation(fields: [clanId], references: [id])
  season               Season   @relation(fields: [seasonId], references: [id])
}

model Player {
  playerTag          String                         @id
  currentName        String
  createdAt          DateTime                       @default(now())
  attacks            Attack[]
  events             CareerEvent[]
  cwlApplications    CwlApplication[]
  cwlAssignments     CwlAssignment[]
  defensiveOverrides CwlDefensiveStrengthOverride[]
}

model Attack {
  id                      Int     @id @default(autoincrement())
  warTag                  String
  playerTag               String
  defenderTag             String
  defenderName            String
  warDay                  Int
  attackNumber            Int
  stars                   Int
  destruction             Int
  duration                Int
  attackerTownHall        Int
  defenderTownHall        Int
  defenseStars            Int
  defenseDestruction      Int
  defenseAttackerTownHall Int
  isOwnAttack             Boolean @default(true)
  player                  Player  @relation(fields: [playerTag], references: [playerTag])
  war                     War     @relation(fields: [warTag], references: [warTag])

  @@unique([warTag, playerTag, attackNumber])
}

model CareerEvent {
  id          Int      @id @default(autoincrement())
  playerTag   String
  date        DateTime
  type        String
  description String
  createdBy   String
  player      Player   @relation(fields: [playerTag], references: [playerTag])
}

model ImportLog {
  id              Int       @id @default(autoincrement())
  season          String
  startedAt       DateTime
  finishedAt      DateTime?
  warsImported    Int
  attacksImported Int
  success         Boolean
  error           String?
  createdAt       DateTime  @default(now())
  successfulSync  Boolean   @default(false)
}

model SystemState {
  id            Int       @id @default(1)
  mode          String    @default("IDLE")
  currentSeason String?
  lastCheck     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CwlMatchup {
  id               Int       @id @default(autoincrement())
  season           String
  round            Int
  warTag           String    @unique
  warSize          Int?
  clanATag         String
  clanAName        String
  clanAStars       Int       @default(0)
  clanADestruction Float     @default(0)
  clanABonusStars  Int       @default(0)
  clanAResult      String?
  clanAIsTDG       Boolean   @default(false)
  clanBTag         String
  clanBName        String
  clanBStars       Int       @default(0)
  clanBDestruction Float     @default(0)
  clanBBonusStars  Int       @default(0)
  clanBResult      String?
  clanBIsTDG       Boolean   @default(false)
  status           String?
  endTime          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum AdminPermissionLevel {
  READ
  EDIT
  DELETE
}

model AdminUser {
  id                Int                   @id @default(autoincrement())
  username          String                @unique
  passwordHash      String
  role              AdminRole             @default(ADMIN)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sessions          AdminSession[]
  auditLogs         AuditLog[]
  permissions       AdminUserPermission[]
  finalizedCwlPlans CwlPlan[]             @relation("CwlPlanFinalizedBy")
}

model AdminPermission {
  id          Int                   @id @default(autoincrement())
  key         String                @unique
  name        String
  description String?
  createdAt   DateTime              @default(now())
  admins      AdminUserPermission[]
}

model AdminUserPermission {
  id           Int                  @id @default(autoincrement())
  adminId      Int
  permissionId Int
  level        AdminPermissionLevel @default(READ)
  createdAt    DateTime             @default(now())

  admin      AdminUser       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([adminId, permissionId])
  @@index([adminId])
  @@index([permissionId])
}

model AdminSession {
  id         String    @id
  adminId    Int
  deviceId   String
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([createdAt])
}

model RegularWar {
  warTag        String   @id
  clanTag       String
  opponentTag   String
  clanName      String
  opponentName  String
  teamSize      Int
  clanStars     Int      @default(0)
  opponentStars Int      @default(0)
  warStartTime  DateTime
  warEndTime    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  players RegularWarPlayer[]
  attacks RegularWarAttack[]

  @@index([clanTag])
  @@index([warEndTime])
}

model RegularWarAttack {
  id               Int      @id @default(autoincrement())
  warTag           String
  playerTag        String
  playerName       String
  defenderTag      String
  defenderName     String
  attackNumber     Int
  stars            Int
  destruction      Int
  duration         Int      @default(0)
  attackerTownHall Int
  defenderTownHall Int
  createdAt        DateTime @default(now())

  war RegularWar @relation(fields: [warTag], references: [warTag], onDelete: Cascade)

  @@unique([warTag, playerTag, attackNumber])
  @@index([playerTag])
  @@index([warTag])
}

model RegularWarPlayer {
  id              Int      @id @default(autoincrement())
  warTag          String
  playerTag       String
  playerName      String
  attacksExpected Int      @default(2)
  attacksDone     Int      @default(0)
  missedAttacks   Int      @default(0)
  oneStars        Int      @default(0)
  twoStars        Int      @default(0)
  threeStars      Int      @default(0)
  totalStars      Int      @default(0)
  createdAt       DateTime @default(now())

  war RegularWar @relation(fields: [warTag], references: [warTag], onDelete: Cascade)

  @@unique([warTag, playerTag])
  @@index([playerTag])
  @@index([warTag])
}

model MissedAttack {
  id            Int      @id @default(autoincrement())
  clanTag       String
  warTag        String
  playerTag     String
  playerName    String
  missedAttacks Int
  warEndTime    DateTime
  createdAt     DateTime @default(now())

  @@index([clanTag])
  @@index([playerTag])
  @@index([warTag])
  @@index([createdAt])
}

/**
 * |--------------------------------------------------------------------------
 * | CWL SELECTION & ASSIGNMENT
 * |--------------------------------------------------------------------------
 */

enum CwlAvailability {
  FULL
  LIMITED
}

enum CwlApplicationStatus {
  AUTO_APPROVED
  PENDING
  APPROVED
  REJECTED
}

enum CwlPlanStatus {
  DRAFT
  FINAL
}

enum CwlAssignmentRole {
  STARTER
  RESERVE
}

enum CwlAssignmentSource {
  ENGINE
  MANUAL
}

enum CwlClanFormat {
  V15
  V30
}

model CwlApplication {
  id           Int                  @id @default(autoincrement())
  season       String
  playerTag    String
  clashName    String
  availability CwlAvailability
  status       CwlApplicationStatus @default(PENDING)
  submittedAt  DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  player Player? @relation(fields: [playerTag], references: [playerTag], onDelete: Cascade)

  @@unique([season, playerTag])
  @@index([season])
  @@index([playerTag])
  @@index([status])
}

model CwlPlan {
  id            Int           @id @default(autoincrement())
  season        String        @unique
  status        CwlPlanStatus @default(DRAFT)
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  finalizedAt   DateTime?
  finalizedById Int?

  finalizedBy AdminUser?    @relation("CwlPlanFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  clanPlans   CwlClanPlan[]

  @@index([status])
  @@index([finalizedById])
}

model CwlClanPlan {
  id          Int           @id @default(autoincrement())
  planId      Int
  clanTag     String
  format      CwlClanFormat
  starters    Int
  minReserves Int
  maxReserves Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  plan        CwlPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignments CwlAssignment[]

  @@unique([planId, clanTag])
  @@index([planId])
  @@index([clanTag])
}

model CwlAssignment {
  id              Int                 @id @default(autoincrement())
  clanPlanId      Int
  playerTag       String
  playerName      String?
  role            CwlAssignmentRole
  source          CwlAssignmentSource @default(ENGINE)
  position        Int
  score           Float
  townHall        Int?
  stars           Int                 @default(0)
  attacks         Int                 @default(0)
  missedAttacks   Int                 @default(0)
  difficultyBonus Float               @default(0)
  defenceStars    Int                 @default(0)
  availability    CwlAvailability?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  clanPlan CwlClanPlan @relation(fields: [clanPlanId], references: [id], onDelete: Cascade)
  player   Player?     @relation(fields: [playerTag], references: [playerTag])

  @@unique([clanPlanId, playerTag])
  @@unique([clanPlanId, position])
  @@index([clanPlanId])
  @@index([playerTag])
  @@index([role])
}

model CwlPlayerSnapshot {
  id              Int      @id @default(autoincrement())
  playerTag       String
  name            String
  townHall        Int
  experienceLevel Int      @default(0)
  attackWins      Int      @default(0)
  defenseWins     Int      @default(0)
  trophies        Int      @default(0)
  warStars        Int      @default(0)
  builderHall     Int?
  snapshotDate    DateTime @default(now())
  snapshotType    String   @default("OWN_CLAN")

  @@index([playerTag])
  @@index([snapshotDate])
}

/**
 * |--------------------------------------------------------------------------
 * | HISTORISCHE CWL SNAPSHOT
 * |--------------------------------------------------------------------------
 * |
 * | Bewaart de volledige Clash API-response van een CWL-war.
 * | Hierdoor kunnen we later opnieuw analyseren zonder afhankelijk
 * | te zijn van het opnieuw beschikbaar zijn van de Clash API.
 * |
 */

model CwlHistoricalWar {
  id          Int      @id @default(autoincrement())
  warTag      String   @unique
  season      String
  round       Int
  state       String
  teamSize    Int
  clanTag     String
  opponentTag String
  rawData     Json
  importedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  players CwlHistoricalPlayer[]

  @@index([season])
  @@index([round])
  @@index([clanTag])
  @@index([opponentTag])
}

model CwlHistoricalPlayer {
  id                 Int      @id @default(autoincrement())
  warId              Int
  playerTag          String
  name               String
  townHall           Int
  mapPosition        Int
  attacks            Json
  opponentAttacks    Json
  bestOpponentAttack Json?
  importedAt         DateTime @default(now())

  war CwlHistoricalWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@unique([warId, playerTag])
  @@index([playerTag])
  @@index([mapPosition])
}

/**
 * |--------------------------------------------------------------------------
 * | CWL DEFENSIVE STRENGTH OVERRIDE
 * |--------------------------------------------------------------------------
 * |
 * | Handmatige uitzonderingen op de automatische Defensive Strength.
 * |
 * | MAX = speler wordt op 100 gezet.
 * |
 * | De override is gekoppeld aan clan + speler.
 * | Zodra de speler TH19 bereikt, moet de override automatisch
 * | ongeldig worden en neemt de automatische berekening het weer over.
 * |
 */

enum CwlDefensiveStrengthOverrideType {
  MAX
}

model CwlDefensiveStrengthOverride {
  id        Int                              @id @default(autoincrement())
  clanTag   String
  playerTag String
  type      CwlDefensiveStrengthOverrideType @default(MAX)
  reason    String?
  createdAt DateTime                         @default(now())
  updatedAt DateTime                         @updatedAt

  player Player @relation(fields: [playerTag], references: [playerTag], onDelete: Cascade)

  @@unique([clanTag, playerTag])
  @@index([clanTag])
  @@index([playerTag])
}

/**
 * --------------------------------------------------------------------------
 * TDG RANDOM ARMY CHALLENGE
 * --------------------------------------------------------------------------
 */

enum RandomChallengeStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum RandomChallengeEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

model RandomChallenge {
  id             Int                   @id @default(autoincrement())
  title          String
  townHall       Int
  baseId         Int?
  startsAt       DateTime
  generationAt   DateTime
  endsAt         DateTime
  status         RandomChallengeStatus @default(DRAFT)
  sourceArmyId   Int?
  sourceArmyName String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  base     Base?                    @relation(fields: [baseId], references: [id])
  results  RandomChallengeResult[]
  entries  RandomChallengeEntry[]
  variants RandomChallengeVariant[]

  @@index([status])
  @@index([startsAt])
  @@index([generationAt])
  @@index([endsAt])
}

model RandomChallengeVariant {
  id             Int      @id @default(autoincrement())
  challengeId    Int
  difficulty     String
  mutatedPercent Int
  sourceArmyId   Int
  sourceArmyName String
  army           Json
  armyShareCode  String?
  generatedAt    DateTime @default(now())
  lockedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  challenge RandomChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, difficulty])
  @@index([challengeId])
  @@index([difficulty])
}

model RandomChallengeEntry {
  id             Int                        @id @default(autoincrement())
  challengeId    Int
  playerTag      String
  playerName     String
  status         RandomChallengeEntryStatus @default(PENDING)
  screenshotPath String?
  ocrResult      Json?
  adminNote      String?
  reviewedBy     String?
  submittedAt    DateTime                   @default(now())
  reviewedAt     DateTime?

  challenge RandomChallenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  result    RandomChallengeResult?

  @@unique([challengeId, playerTag])
  @@index([challengeId])
  @@index([playerTag])
  @@index([status])
}

model RandomChallengeResult {
  id          Int      @id @default(autoincrement())
  entryId     Int      @unique
  stars       Int      @default(0)
  destruction Float    @default(0)
  timeSeconds Int?
  score       Float    @default(0)
  rank        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entry             RandomChallengeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  randomChallenge   RandomChallenge?     @relation(fields: [randomChallengeId], references: [id])
  randomChallengeId Int?

  @@index([score])
  @@index([rank])
}

/**
 * --------------------------------------------------------------------------
 * TDG DISCOVERY ARMIES
 * --------------------------------------------------------------------------
 * Actuele army-dataset voor de TDG Discovery Challenge.
 * De dataset wordt periodiek volledig ververst vanuit ClashKing.
 * --------------------------------------------------------------------------
 */

enum DiscoveryTier {
  L1
  L2
  L3
}

model DiscoveryArmy {
  id              Int           @id @default(autoincrement())
  tier            DiscoveryTier
  name            String
  fingerprint     String
  armyShareCode   String?
  troops          Json
  spells          Json
  siegeMachine    Json?
  heroes          Json
  pets            Json
  usageCount      Int           @default(0)
  usagePercentage Float         @default(0)
  daysSeen        Int           @default(0)
  source          String        @default("ClashKing")
  importedAt      DateTime      @default(now())

  cycle      Int       @default(1)
  isUsed     Boolean   @default(false)
  lastUsedAt DateTime?

  @@unique([tier, fingerprint])
  @@index([tier])
  @@index([tier, usageCount])
  @@index([tier, isUsed])
  @@index([tier, cycle])
}

/**
 * --------------------------------------------------------------------------
 * PHOENIX GAME CATALOG
 * --------------------------------------------------------------------------
 * Vaste interne woordenlijst van alle Clash-content die Phoenix gebruikt.
 * Phoenix gebruikt zijn eigen numerieke ID's. Externe game-data (zoals
 * dataId's of army-share-codes) zijn alleen mappings naar deze catalogus.
 * --------------------------------------------------------------------------
 */

enum GameCatalogType {
  TROOP
  SPELL
  SIEGE_MACHINE
  HERO
  PET
  HERO_EQUIPMENT
}

model GameCatalogItem {
  id           Int             @id @default(autoincrement())
  type         GameCatalogType
  name         String
  slug         String
  dataId       Int?
  iconPath     String?
  isSuperTroop Boolean         @default(false)
  baseItemId   Int?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  baseItem      GameCatalogItem?  @relation("SuperTroopBase", fields: [baseItemId], references: [id])
  superVariants GameCatalogItem[] @relation("SuperTroopBase")
  armyCodes     GameArmyCodeMap[]

  @@unique([type, slug])
  @@index([type])
  @@index([dataId])
  @@index([baseItemId])
}

/**
 * --------------------------------------------------------------------------
 * PHOENIX ARMY CODE MAPPING
 * --------------------------------------------------------------------------
 * Koppelt externe Army Share Code-ID's aan onze eigen GameCatalogItem IDs.
 * De generator werkt uitsluitend met Phoenix catalogus-ID's.
 * De broncode van een externe provider is hier alleen een mapping.
 * --------------------------------------------------------------------------
 */

model GameArmyCodeMap {
  id            Int             @id @default(autoincrement())
  source        String
  type          GameCatalogType
  code          Int
  catalogItemId Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  catalogItem GameCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([source, type, code])
  @@index([source])
  @@index([type])
  @@index([catalogItemId])
}
