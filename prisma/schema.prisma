generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Base {
  id          Int      @id @default(autoincrement())
  townHall    Int
  category    String
  name        String
  description String?
  baseLink    String
  createdBy   String
  createdAt   DateTime @default(now())
}